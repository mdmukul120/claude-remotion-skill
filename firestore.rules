rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidAsset(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'type', 'url']) &&
             data.keys().hasOnly(['id', 'name', 'category', 'type', 'url', 'localPath', 'durationFrames', 'bpm', 'description', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 120 &&
             data.category in ['sfx', 'music', 'overlay', 'font', 'graphic'] &&
             data.type is string && data.type.size() <= 64 &&
             data.url is string && data.url.size() <= 1024 &&
             (!('localPath' in data) || (data.localPath is string && data.localPath.size() <= 256)) &&
             (!('durationFrames' in data) || data.durationFrames is number) &&
             (!('bpm' in data) || data.bpm is number) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /remotion_assets/{assetId} {
      allow read: if true;
      allow create: if isValidId(assetId) && isValidAsset(incoming());
      allow update: if isValidId(assetId) && isValidAsset(incoming());
      allow delete: if isValidId(assetId);
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
